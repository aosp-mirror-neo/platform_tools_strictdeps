java_library_host {
    name: "soong_java_strict_deps_plugin_lib",
    srcs: ["src/**/*.java"],
    libs: ["auto_service_annotations"],
    plugins: ["auto_service_plugin"],
}

java_plugin {
    name: "soong_java_strict_deps_plugin",
    static_libs: ["soong_java_strict_deps_plugin_lib"],
}

java_test_host {
    name: "soong_java_strict_deps_plugin_test",
    srcs: ["test/**/*.java"],
    static_libs: [
        "soong_java_strict_deps_plugin_lib",
        "junit",
    ],
    test_suites: ["general-tests"],
    team: "trendy_team_build",
}
